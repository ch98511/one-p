<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Camera Radar"
            android:textColor="@color/text"
            android:textSize="22sp"
            android:textStyle="bold"
            android:paddingBottom="12dp" />

        <!-- Status card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/panel"
            android:padding="20dp"
            android:gravity="center">

            <TextView
                android:id="@+id/statusDist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="—"
                android:textColor="@color/text"
                android:textSize="42sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/statusLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Not monitoring"
                android:textColor="@color/text"
                android:textSize="15sp"
                android:textStyle="bold"
                android:paddingTop="4dp" />

            <TextView
                android:id="@+id/statusSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Press Start to watch for cameras"
                android:textColor="@color/muted"
                android:textSize="13sp"
                android:paddingTop="4dp" />
        </LinearLayout>

        <com.onep.camradar.RadarView
            android:id="@+id/radar"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:layout_marginTop="12dp"
            android:background="@color/panel" />

        <!-- Stats -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@color/panel"
                android:padding="12dp">
                <TextView android:id="@+id/camCount" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="0"
                    android:textColor="@color/text" android:textSize="20sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="cameras nearby" android:textColor="@color/muted" android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@color/panel"
                android:padding="12dp">
                <TextView android:id="@+id/gpsAcc" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="—"
                    android:textColor="@color/text" android:textSize="20sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="GPS ± m" android:textColor="@color/muted" android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/alertLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Alert distance: 150 m"
            android:textColor="@color/text"
            android:textSize="14sp"
            android:paddingTop="16dp" />

        <SeekBar
            android:id="@+id/alertSeek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <Switch
            android:id="@+id/flockSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Only cameras tagged Flock"
            android:textColor="@color/text" />

        <TextView
            android:id="@+id/dataInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Loading camera data…"
            android:textColor="@color/muted"
            android:textSize="12sp"
            android:paddingTop="10dp" />

        <LinearLayout
            android:id="@+id/listContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="8dp"
            android:background="@color/panel" />

        <Button
            android:id="@+id/startBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Start monitoring"
            android:backgroundTint="@color/sky"
            android:textColor="@color/ink" />

        <Button
            android:id="@+id/stopBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Stop"
            android:backgroundTint="@color/panel2"
            android:textColor="@color/text"
            android:visibility="gone" />

        <Button
            android:id="@+id/testBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Test alert"
            android:backgroundTint="@color/panel2"
            android:textColor="@color/text" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="16dp"
            android:text="Camera locations from OpenStreetMap / DeFlock (ODbL). Runs fully offline — the app has no internet permission. Don't use while driving distracted."
            android:textColor="@color/muted"
            android:textSize="11sp" />
    </LinearLayout>
</ScrollView>
