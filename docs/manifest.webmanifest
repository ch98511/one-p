{
  "name": "Flock Camera Radar",
  "short_name": "Cam Radar",
  "description": "Live map of ALPR/Flock cameras, public surveillance and weather radar, with proximity alerts and constraint-aware routing (avoid cameras, tolls, highways or areas). Data from OpenStreetMap, RainViewer and Valhalla.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0f172a",
  "theme_color": "#0f172a",
  "icons": [
    { "src": "./icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "./icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "./icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
