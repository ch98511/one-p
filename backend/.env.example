# ---- Copy to .env and edit ----

# OSM extract Valhalla builds its routing graph from.
# Pick your region from https://download.geofabrik.de (state/country .osm.pbf).
# Smaller = faster first build. Example: US state of Indiana.
PBF_URL=https://download.geofabrik.de/north-america/us/indiana-latest.osm.pbf

# Valhalla
VALHALLA_PORT=8002
VALHALLA_THREADS=2

# PostGIS
POSTGRES_USER=flock
POSTGRES_PASSWORD=flock
POSTGRES_DB=flock
POSTGRES_PORT=5432

# Caddy reverse proxy (only used with:  docker compose --profile proxy up)
PROXY_HTTP_PORT=8080
PROXY_HTTPS_PORT=8443
